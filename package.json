{
  "name": "trublue-job-estimator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/sync.ts pull",
    "dev": "next dev -p 3123",
    "build": "next build",
    "prestart": "tsx scripts/sync.ts pull",
    "start": "next start -p 3123",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts && tsx scripts/sync.ts pull",
    "setup": "npm install && tsx scripts/sync.ts pull",
    "sync": "tsx scripts/sync.ts share",
    "dev:offline": "next dev -p 3123"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
